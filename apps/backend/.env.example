# =============================================================================
# Societe Generale - Bank Account Management API
# Example environment file.
#
# SECURITY (sc Mandatory Secured Development Controls #1, #25):
#   * NEVER commit a real .env file. `.env` is git-ignored.
#   * The application reads ONLY from process.env - there is no code path that
#     requires a file. Exporting these in your shell (from the OS credential
#     store or a key vault) is therefore strictly better than a plaintext .env
#     on disk, and needs no code change. See SECURITY.md, deviation DEV-2.
#   * The application FAILS TO START if any required value below is missing or
#     too weak (fail securely - principle #5).
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Comma-separated allow-list. Never use "*" (OWASP A02:2025).
CORS_ORIGINS=http://localhost:5173

# How many reverse-proxy hops sit in front of this service. Express uses it to
# find the real client IP, which every per-IP rate limit keys on.
#   0 = running directly (npm run dev)
#   1 = behind one nginx / load balancer
#   2 = Azure load balancer + the web pod's nginx (the AKS deployment)
TRUST_PROXY_HOPS=0

# ---- Database ----------------------------------------------------------------
# Must name a least-privilege application user - readWrite on the app database
# only, never root / DBA. docker-compose creates exactly such a user.
MONGODB_URI=mongodb://sgbank_app:CHANGE_ME@localhost:27017/sgbank?authSource=sgbank
MONGODB_TLS=false
# Optional. Only needed for a PRIVATE certificate authority. Managed providers
# such as MongoDB Atlas use a public CA that Node already trusts, and a
# `mongodb+srv://` URI turns TLS on at the driver level by itself.
MONGODB_CA_FILE=

# ---- Crypto ------------------------------------------------------------------
# Generate all three with: npm run genkeys
# JWT_SECRET       : HS256 signing key for access / refresh tokens (>= 64 hex chars)
# FIELD_ENC_KEY    : AES-256-GCM key for application-level field encryption (64 hex chars = 32 bytes)
# BLIND_INDEX_KEY  : HMAC-SHA256 key used to build searchable blind indexes (64 hex chars)
JWT_SECRET=
FIELD_ENC_KEY=
BLIND_INDEX_KEY=
# Key identifier - lets you rotate FIELD_ENC_KEY without rewriting history
# (cryptoagility, Mandatory Control "Cryptoagility").
FIELD_ENC_KEY_ID=k1

# ---- Tokens / session --------------------------------------------------------
ACCESS_TOKEN_TTL_SECONDS=900          # 15 minutes
REFRESH_TOKEN_TTL_SECONDS=28800       # 8 hours  (absolute timeout)
REFRESH_IDLE_TIMEOUT_SECONDS=1800     # 30 minutes (idle timeout)
JWT_ISSUER=sg-bank-accounts
JWT_AUDIENCE=sg-bank-accounts-web

# ---- Identity Provider (production path) -------------------------------------
# When AUTH_MODE=oidc the local credential store is disabled entirely and all
# tokens are validated against the IdP JWKS. See src/services/auth/README.md.
# AUTH_MODE=local | oidc
AUTH_MODE=local
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# ---- Bootstrap admin (used only by `npm run seed`) ---------------------------
# Delete these from the environment once the admin account exists.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
